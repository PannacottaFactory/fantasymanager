{
  "name": "arenes-de-l-ombre",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shadow Arenas — a deep fantasy arena league management game (browser, front-end only).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:match": "tsx src/sim/match.ts",
    "sim:batch": "tsx src/sim/batch.ts",
    "sim:season": "tsx src/sim/season.ts",
    "sim:balance": "tsx src/sim/balance.ts",
    "sim:species": "tsx src/sim/species.ts"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/game-icons": "^1.2.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
